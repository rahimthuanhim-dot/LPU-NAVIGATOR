{
  "version": 8,
  "name": "Offline campus map",
  "glyphs": "file://__APP_STORAGE__/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "campus": {
      "type": "geojson",
      "data": "file://__APP_STORAGE__/campus_layers.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2efe9"
      }
    },
    {
      "id": "campus-buildings",
      "type": "fill",
      "source": "campus",
      "filter": ["==", "kind", "building"],
      "paint": {
        "fill-color": "#9ccfa3",
        "fill-opacity": 0.65,
        "fill-outline-color": "#263238"
      }
    },
    {
      "id": "campus-paths",
      "type": "line",
      "source": "campus",
      "filter": ["==", "kind", "path"],
      "paint": {
        "line-color": "#263238",
        "line-width": 4
      }
    },
    {
      "id": "campus-entrances",
      "type": "circle",
      "source": "campus",
      "filter": ["==", "kind", "entrance"],
      "paint": {
        "circle-color": "#d32f2f",
        "circle-radius": 5,
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 2
      }
    },
    {
      "id": "campus-building-labels",
      "type": "symbol",
      "source": "campus",
      "filter": ["==", "kind", "building_label"],
      "layout": {
        "symbol-placement": "point",
        "text-field": ["get", "name"],
        "text-font": ["NotoSansRegular"],
        "text-size": 14,
        "text-offset": [0, 0],
        "text-anchor": "center",
        "text-allow-overlap": true,
        "text-ignore-placement": true
      },
      "paint": {
        "text-color": "#111827",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}
